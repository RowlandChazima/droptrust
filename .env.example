# ==============================================================================
# DropTrust Capture — Environment Variable Template
# Copy this file to .env.local and populate with your own project credentials.
# NEVER commit .env.local or service role keys to source control.
# ==============================================================================

# Supabase Project Configuration
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Key (Trusted Server-Side ONLY — NEVER expose to browser)
# Used exclusively by background webhooks and administrative stored procedures.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PayPal Developer Sandbox Configuration
# Obtain from PayPal Developer Dashboard -> Apps & Credentials (Sandbox)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com

